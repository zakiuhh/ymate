# Copy this file to ".env" and uncomment what you need.
# Everything here is optional.

# Only needed if yt-dlp is not on your PATH (or next to server.js).
# YTDLP_PATH="C:/tools/yt-dlp.exe"

# Only needed if ffmpeg is not on your PATH. File or folder both work.
# FFMPEG_PATH="C:/tools/ffmpeg/bin"

# PORT=3000
# Default save folder. You can change it any time from the app ("Save to").
# DOWNLOAD_DIR=downloads

# Share on your local network (phones, other laptops). There is no login,
# so only do this on a network you trust.
# HOST=0.0.0.0
